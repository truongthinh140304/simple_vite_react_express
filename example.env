# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration
# Replace <username> with your PostgreSQL username
# Format: postgres://<username>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgres://<username>@localhost:5432/simple-vite-db?schema=public"

# JWT Configuration (REQUIRED)
# Generate a strong secret key for JWT signing
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-me-in-production"

# CORS Configuration (Optional)
CORS_ORIGIN="*"